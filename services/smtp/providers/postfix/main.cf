# AmberCell Postfix sinkhole — corp.example.net only; no outbound relay.
compatibility_level = 3.6
biff = no
append_dot_mydomain = no

inet_interfaces = all
inet_protocols = ipv4

myhostname = mail.corp.example.net
mydomain = corp.example.net
myorigin = corp.example.net
mydestination = localhost.localdomain, localhost

virtual_alias_domains = corp.example.net
virtual_alias_maps = texthash:/etc/postfix/virtual
local_recipient_maps =
relayhost =
relay_domains =
default_transport = local
local_transport = local:$myhostname

mynetworks = 127.0.0.0/8, 172.30.0.0/16
smtpd_relay_restrictions = permit_mynetworks, reject_unauth_destination
smtpd_recipient_restrictions =
    reject_non_fqdn_recipient,
    reject_unauth_destination,
    permit

smtpd_banner = $myhostname ESMTP Postfix (AmberCell sinkhole)
smtpd_helo_required = no
disable_vrfy_command = yes
message_size_limit = 10485760
mailbox_size_limit = 0
