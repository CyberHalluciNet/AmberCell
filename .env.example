# AmberCell lab/local defaults — copy to .env and fill secrets locally.
# Never commit real secrets. Production secrets live under /etc/ambercell/ (mode 0600).
# Interactive: amberctl init (TTY) or amberctl init --wizard writes provider keys below.
# Scripts/CI: amberctl init --yes  (or AMBER_INIT_NONINTERACTIVE=1)

# Compose profile: lab (default) | production
# COMPOSE_PROFILES=lab,core
# COMPOSE_PROFILES=lab,core,wave-a
# COMPOSE_PROFILES=lab,wave-b,wave-c
# COMPOSE_PROFILES=lab,wave-d,wave-e
# AMBER_SMOKE_SKIP_ELASTIC=1

# Protocol cell providers (defaults match Stage-0A catalog)
AMBER_SMTP_PROVIDER=postfix
AMBER_POP3_PROVIDER=dovecot
AMBER_FTP_PROVIDER=vsftpd
AMBER_SSH_PROVIDER=openssh
AMBER_REDIS_PROVIDER=redis-server
AMBER_MQTT_PROVIDER=mosquitto
AMBER_HTTP_PROVIDER=nginx
AMBER_TELNET_PROVIDER=busybox-telnetd
AMBER_MYSQL_PROVIDER=mariadb
AMBER_POSTGRES_PROVIDER=postgresql
AMBER_SMB_PROVIDER=samba
AMBER_MONGO_PROVIDER=mongodb
AMBER_ELASTIC_PROVIDER=elasticsearch
AMBER_DOCKERAPI_PROVIDER=trap
AMBER_KUBELET_PROVIDER=trap
AMBER_OLLAMA_PROVIDER=mock
AMBER_DNS_PROVIDER=coredns
AMBER_TFTP_PROVIDER=dnsmasq
AMBER_SNMP_PROVIDER=snmpd
AMBER_NTP_PROVIDER=chrony          # beta cell
AMBER_SYSLOG_PROVIDER=rsyslog      # beta cell
AMBER_SIP_PROVIDER=kamailio
AMBER_LDAP_PROVIDER=openldap        # beta cell (slapd idles ~700MB; 1g tier)
AMBER_IMAP_PROVIDER=dovecot
AMBER_MEMCACHED_PROVIDER=memcached
AMBER_RDP_PROVIDER=xrdp
AMBER_VNC_PROVIDER=tigervnc
AMBER_NETBIOS_PROVIDER=nmbd

# Premade alternates (each cell ships ≥3 Dockerfiles — see docs/providers.md)
# AMBER_FTP_PROVIDER=proftpd          # or pure-ftpd
# AMBER_SMTP_PROVIDER=exim            # or opensmtpd
# AMBER_POP3_PROVIDER=cyrus           # or courier
# AMBER_TELNET_PROVIDER=inetutils-telnetd  # or netkit-telnetd
# AMBER_SSH_PROVIDER=dropbear         # or tinyssh
# AMBER_REDIS_PROVIDER=valkey         # or keydb
# AMBER_MQTT_PROVIDER=nanomq          # or emqx
# AMBER_HTTP_PROVIDER=httpd           # or caddy
# AMBER_MYSQL_PROVIDER=percona        # or mysql
# AMBER_POSTGRES_PROVIDER=pgvector    # or timescaledb
# AMBER_SMB_PROVIDER=samba-ad         # or samba-shares
# AMBER_MONGO_PROVIDER=ferretdb       # or mock (prefer over mongodb/SSPL)
# AMBER_ELASTIC_PROVIDER=opensearch   # or zincsearch (prefer over elasticsearch)
# AMBER_DOCKERAPI_PROVIDER=trap-v1.41 # or trap-swarm
# AMBER_KUBELET_PROVIDER=trap-unauth  # or trap-exec
# AMBER_OLLAMA_PROVIDER=ollama        # or localai
# AMBER_DNS_PROVIDER=bind9            # or unbound
# AMBER_TFTP_PROVIDER=tftpd-hpa       # or atftpd (random transfer ports — NAT caveat)
# AMBER_SNMP_PROVIDER=snmpd-debian    # net-snmp (both premade are net-snmp builds)
# AMBER_NTP_PROVIDER=openntpd         # or ntp-classic
# AMBER_SYSLOG_PROVIDER=syslog-ng
# AMBER_SIP_PROVIDER=opensips
# AMBER_LDAP_PROVIDER=glauth
# Remote tunnel (wave-h): AMBER_IMAP_REMOTE_ADDR=imap.corp:143 etc.
# AMBER_IMAP_PROVIDER=remote  AMBER_MEMCACHED_PROVIDER=remote

# Remote tunnel — point a cell at your own existing server (any address,
# not just localhost): AMBER_<SVC>_PROVIDER=remote + the backend address.
# The backend must be reachable from the cell (egress allowlist, G14).
# AMBER_TFTP_PROVIDER=remote  AMBER_TFTP_REMOTE_ADDR=10.0.0.5:69
# AMBER_SNMP_PROVIDER=remote  AMBER_SNMP_REMOTE_ADDR=snmp.corp:161
# AMBER_NTP_PROVIDER=remote   AMBER_NTP_REMOTE_ADDR=ntp.corp:123
# AMBER_SYSLOG_PROVIDER=remote AMBER_SYSLOG_REMOTE_ADDR=syslog.corp:514
# AMBER_SIP_PROVIDER=remote   AMBER_SIP_REMOTE_ADDR=sbc.corp:5060
# AMBER_LDAP_PROVIDER=remote  AMBER_LDAP_REMOTE_ADDR=ldap.corp:389

# Own Docker — precedence: HI_IMAGE > PROVIDER_CONTEXT > builtin PROVIDER path
# amberctl up resolves/exports these before compose; HI_IMAGE skips hi image build.
# AMBER_FTP_PROVIDER=custom
# AMBER_FTP_HI_IMAGE=registry.example/amber-ftp@sha256:…
# AMBER_FTP_PROVIDER_CONTEXT=/home/op/my-ftp
# Same pattern for every cell: AMBER_<SVC>_HI_IMAGE / AMBER_<SVC>_PROVIDER_CONTEXT
# (SMTP, POP3, TELNET, SSH, REDIS, MQTT, HTTP, MYSQL, POSTGRES, SMB, MONGO,
#  ELASTIC, DOCKERAPI, KUBELET, OLLAMA, DNS)

# Public IP advertised in FTP PASV (required for Internet PASV in production)
AMBER_FTP_PASV_ADDRESS=

# Lab published ports (localhost only — see compose.lab.yaml)
# AMBER_SSH_HOST_PORT=2222
# AMBER_REDIS_HOST_PORT=6379
# AMBER_MQTT_HOST_PORT=1883
# AMBER_DOCKERAPI_HOST_PORT=2375
# AMBER_KUBELET_HOST_PORT=10250
# AMBER_OLLAMA_HOST_PORT=11434
# AMBER_DNS_HOST_PORT=1053
# AMBER_TFTP_HOST_PORT=1069
# AMBER_SNMP_HOST_PORT=1161
# AMBER_NTP_HOST_PORT=1123
# AMBER_SYSLOG_HOST_PORT=1514
# AMBER_SIP_HOST_PORT=15060
# AMBER_LDAP_HOST_PORT=1389
# AMBER_IMAP_HOST_PORT=1143
# AMBER_MEMCACHED_HOST_PORT=11211
# AMBER_RDP_HOST_PORT=13389
# AMBER_VNC_HOST_PORT=15900
# AMBER_NETBIOS_HOST_PORT=1137

# Dead drop optional S3 mirror (empty = local drop only)
AMBER_DEADDROP_S3_URI=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# Webhook endpoints (Stage-4; leave empty until configured)
AMBER_WEBHOOK_URL=
AMBER_WEBHOOK_TOKEN=

# AI manager (advisory by default; no cloud key required for kill bars)
AMBER_AI_MODE=advisory
# AMBER_AI_API_KEY=
